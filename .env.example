# Copy to .env.local for local development. Set the same keys in Vercel for production.

# Web3Forms key (public by design). Falls back to the key in src/lib/contact.ts.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Canonical site URL for metadata, sitemap and robots, e.g. https://bigo.example.
# On Vercel the production domain is used automatically when this is empty.
NEXT_PUBLIC_SITE_URL=

# Optional SMTP fallback for the contact form (/api/contact).
# Nothing is sent through SMTP unless SMTP_HOST, SMTP_USER and SMTP_PASS are all set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Inbox for SMTP enquiries. Defaults to ENQUIRY_INBOX in src/lib/contact.ts.
CONTACT_EMAIL=
